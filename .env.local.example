# Supabase — copy from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key          # safe to expose — used only for Realtime subscriptions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # server-only — never expose to client
SUPABASE_PASSWORD=your-db-password
# Map — free account at maptiler.com, no card required
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key

# AI
OPENAI_API_KEY=sk-...
# Image model used to render the customer wearing each recommended cut.
# Defaults to gpt-image-1 (the only OpenAI image-edit model currently available besides dall-e-2).
OPENAI_IMAGE_MODEL=gpt-image-1

# Email — create an API key at resend.com and verify your sending domain
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.co.uk

# Auth — at least 32 chars of random entropy
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-your-own-64-char-hex-secret
# Admin account — these credentials are NOT stored in the database
ADMIN_EMAIL=admin@yourdomain.co.uk
ADMIN_PASSWORD=choose-a-strong-password

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
